{
  "id": "my-practa",
  "name": "My Practa",
  "version": "2.0.1",
  "description": "A starter template for your custom wellbeing experience",
  "author": "Your Name",
  "estimatedDuration": 30,
  "category": "wellness",
  "tags": [
    "starter",
    "template"
  ],
  "assets": {
    "icon": "icon.png",
    "splash": "splash.mp4",
    "wellnessBg": "wellness-bg.png",
    "content": "content.json"
  },
  "dependencies": [
    "@expo/vector-icons",
    "expo-haptics",
    "expo-image",
    "react-native-safe-area-context"
  ],
  "configSchema": {
    "fields": {
      "sessionLength": {
        "type": "number",
        "label": "Session Length",
        "description": "Duration of the session in minutes",
        "default": 5,
        "min": 1,
        "max": 30
      },
      "enableSounds": {
        "type": "boolean",
        "label": "Enable Sounds",
        "description": "Play ambient sounds during the session",
        "default": true
      },
      "theme": {
        "type": "select",
        "label": "Visual Theme",
        "description": "Choose a color theme for the experience",
        "options": [
          {
            "value": "calm",
            "label": "Calm Blue"
          },
          {
            "value": "nature",
            "label": "Nature Green"
          },
          {
            "value": "sunset",
            "label": "Sunset Orange"
          },
          {
            "value": "night",
            "label": "Night Mode"
          }
        ],
        "default": "calm"
      },
      "intention": {
        "type": "string",
        "label": "Session Intention",
        "description": "Set a personal intention for this session",
        "placeholder": "e.g., Find inner peace",
        "default": "",
        "maxLength": 100
      },
      "aiEnabled": {
        "type": "boolean",
        "label": "Enable AI Features",
        "description": "Allow this Practa to use AI-powered enhancements when available",
        "default": true
      }
    },
    "requiredConfig": false
  }
}
